#!/bin/sh
# Fast gate: types, tests, docs, art. Keep this under ~10 seconds or people will skip it.
set -e
echo "pre-commit: typecheck"
npm run --silent typecheck
echo "pre-commit: tests"
npm run --silent test
echo "pre-commit: docs"
npm run --silent docs:check
echo "pre-commit: art"
npm run --silent art:check
